# Leave unset for the GitHub Pages build (data lives in the browser).
# Set it to run the frontend against the FastAPI backend instead:
# NEXT_PUBLIC_API_URL=https://your-backend-domain.example/api/v1

# Optional cross-device sync via Supabase (see supabase/schema.sql).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
